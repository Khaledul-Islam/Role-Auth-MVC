@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0" style="background: white; border-radius: 20px;">
                <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); border-radius: 20px 20px 0 0;">
                    <i class="fas fa-user-shield fa-3x mb-3"></i>
                    <h2 class="mb-0 fw-bold">Admin Dashboard</h2>
                    <p class="mb-0">Full system control and management</p>
                </div>
                <div class="card-body p-5">
                    <div class="alert alert-danger border-0 shadow-sm" role="alert">
                        <i class="fas fa-crown me-2"></i>
                        <strong>Welcome Administrator!</strong> You have full access to all system features.
                    </div>

                    <div class="row g-4 mt-3">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-users fa-3x text-danger mb-3"></i>
                                    <h5 class="fw-bold">User Management</h5>
                                    <p class="text-muted">Manage all system users</p>
                                    <button class="btn btn-danger btn-sm">Manage Users</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-user-tag fa-3x text-danger mb-3"></i>
                                    <h5 class="fw-bold">Role Management</h5>
                                    <p class="text-muted">Configure roles & permissions</p>
                                    <button class="btn btn-danger btn-sm">Manage Roles</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-cog fa-3x text-danger mb-3"></i>
                                    <h5 class="fw-bold">System Settings</h5>
                                    <p class="text-muted">Configure system settings</p>
                                    <button class="btn btn-danger btn-sm">Settings</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-chart-line fa-3x text-danger mb-3"></i>
                                    <h5 class="fw-bold">Analytics</h5>
                                    <p class="text-muted">View system analytics</p>
                                    <button class="btn btn-danger btn-sm">View Reports</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-shield-alt fa-3x text-danger mb-3"></i>
                                    <h5 class="fw-bold">Security</h5>
                                    <p class="text-muted">Security & audit logs</p>
                                    <button class="btn btn-danger btn-sm">View Logs</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-database fa-3x text-danger mb-3"></i>
                                    <h5 class="fw-bold">Database</h5>
                                    <p class="text-muted">Database management</p>
                                    <button class="btn btn-danger btn-sm">Manage DB</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>