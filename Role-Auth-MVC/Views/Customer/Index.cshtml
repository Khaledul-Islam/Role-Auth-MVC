@{
    ViewData["Title"] = "Customer Portal";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0" style="background: white; border-radius: 20px;">
                <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); border-radius: 20px 20px 0 0;">
                    <i class="fas fa-shopping-bag fa-3x mb-3"></i>
                    <h2 class="mb-0 fw-bold">Customer Portal</h2>
                    <p class="mb-0">Your personalized shopping experience</p>
                </div>
                <div class="card-body p-5">
                    <div class="alert alert-success border-0 shadow-sm" role="alert">
                        <i class="fas fa-user-check me-2"></i>
                        <strong>Welcome Customer!</strong> Browse products, place orders, and track your purchases.
                    </div>

                    <div class="row g-4 mt-3">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-shopping-cart fa-3x text-success mb-3"></i>
                                    <h5 class="fw-bold">Shop Products</h5>
                                    <p class="text-muted">Browse our catalog</p>
                                    <button class="btn btn-success btn-sm">Start Shopping</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-box fa-3x text-success mb-3"></i>
                                    <h5 class="fw-bold">My Orders</h5>
                                    <p class="text-muted">Track your orders</p>
                                    <button class="btn btn-success btn-sm">View Orders</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-heart fa-3x text-success mb-3"></i>
                                    <h5 class="fw-bold">Wishlist</h5>
                                    <p class="text-muted">Saved items</p>
                                    <button class="btn btn-success btn-sm">View Wishlist</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-user-circle fa-3x text-success mb-3"></i>
                                    <h5 class="fw-bold">My Profile</h5>
                                    <p class="text-muted">Account settings</p>
                                    <button class="btn btn-success btn-sm">Edit Profile</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>